{
  "name": "juca",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "author": "",
  "license": "ISC",
  "description": "Juca — agente pessoal de IA que vive no WhatsApp e Telegram",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "bullmq": "^6.5.3",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
