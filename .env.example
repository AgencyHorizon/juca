# --- Core ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://seu-dominio.ngrok.app
DATABASE_URL=postgres://juca:juca@localhost:5432/juca
REDIS_URL=redis://localhost:6379
# 32 bytes em base64 (openssl rand -base64 32) — AES-256-GCM p/ dados em repouso
DATA_ENCRYPTION_KEY=
ADMIN_TOKEN=troque-isto

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
JUCA_MODEL=claude-haiku-5-5
JUCA_EFFORT=low
PROMPT_VERSION=v1

# --- Transcrição de voz (RF-07) ---
# NVIDIA NIM (build.nvidia.com) — chave nvapi-...; função padrão = whisper-large-v3
NVIDIA_API_KEY=
NVIDIA_ASR_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
# Hugging Face — reserva caso a NVIDIA falhe
HF_TOKEN=
HF_ASR_MODEL=openai/whisper-large-v3
STT_LANGUAGE=pt

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Limites (RN-11 / RN-12 / RN-14 / RN-16) ---
RATE_LIMIT_PER_HOUR=60
MAX_ACTIVE_REMINDERS=20
SESSION_TIMEOUT_HOURS=24
LOG_RETENTION_DAYS=90
BETA_USER_CAP=1000
